table <G_THREAT_FEEDS> persist  # resolved at run time (FQDN or dynamic alias)
table <NOT_MGMT> const { 0.0.0.0/0 !192.168.90.0/24 }
table <Z_MGMT_EXCEPT> const { 192.168.90.0/24 !192.168.90.10/32 !192.168.90.20/32 }
