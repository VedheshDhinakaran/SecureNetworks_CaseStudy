# R-05  Teleradiology  [owner RAD, review Q]
pass in quick log proto tcp from <H_PACS> to <F_TELERAD> port { 443 2762 } keep state label "R-05"

# R-06  Radiology default deny (incl. internet)  [owner RAD, review Q]
block in quick log from <Z_RADIOLOGY> to any label "R-06"

# C-01  DNS, time, logon  [owner NUR, review Q]
pass in quick log proto tcp from <Z_CLINICAL> to <G_CORE> port { 53 88 636 } keep state label "C-01"
pass in quick log proto udp from <Z_CLINICAL> to <G_CORE> port { 53 88 123 } keep state label "C-01"

# C-02  EMR access  [owner NUR, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): app=emr-web; user=GRP_CLINICIANS; ips=strict
pass in quick log proto tcp from <Z_CLINICAL> to <H_EMR_APP> port 443 keep state label "C-02"

# C-03  Pharmacy system  [owner NUR, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): user=GRP_PHARMACISTS
pass in quick log proto tcp from <Z_CLINICAL> to <H_PHARMACY> port 443 keep state label "C-03"

