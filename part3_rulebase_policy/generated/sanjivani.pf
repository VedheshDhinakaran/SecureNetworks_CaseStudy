# G-01  Drop known-bad sources and destinations before any permit  [owner SEC, review Q]
block in quick log from <G_THREAT_FEEDS> to any label "G-01"

# G-02  Management plane unreachable from user zones  [owner SEC, review Q]
block in quick log from <NOT_MGMT> to <Z_MGMT_EXCEPT> label "G-02"

# G-03  No zone outside HIS ever reaches the EMR database (incident F2)  [owner IT, review Q]
block in quick log from <NOT_HIS_BASTION_NMS> to <H_EMR_DB> label "G-03"

# G-04  Stop DNS bypass and DNS tunnelling  [owner SEC, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): app=dns-over-https
block in quick log proto tcp from <NOT_DNS_PROXY_GUEST_VENDOR_WIFI> to <internet> port { 53 853 } label "G-04"
block in quick log proto udp from <NOT_DNS_PROXY_GUEST_VENDOR_WIFI> to <internet> port 53 label "G-04"

# M-01  Administration only from the bastion  [owner SEC, review Q]
pass in quick log proto tcp from <H_BASTION> to <G_MGMT_TARGETS> port { 22 443 } keep state label "M-01"

# M-02  Server administration  [owner IT, review Q]
pass in quick log proto tcp from <H_BASTION> to <T_HIS_DMZ_RESEARCH> port { 22 3389 } keep state label "M-02"

# M-03  Health monitoring with SNMPv3  [owner IT, review Q]
pass in quick log proto udp from <H_NMS> to <T_HIS_DMZ> port 161 keep state label "M-03"

# M-04  Central logging  [owner SEC, review Q]
pass in quick log proto tcp from <T_HIS_DMZ_RESEARCH_JUMP> to <H_SIEM> port 6514 keep state label "M-04"

# M-05  Off-site backup copy over the DR IPsec tunnel  [owner IT, review Q]
pass in quick log proto tcp from <H_BACKUP> to <H_DR_BACKUP> port 8400 keep state label "M-05"

# M-06  Patches and signature updates  [owner SEC, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): url_category=software-updates
pass in quick log proto tcp from <T_BASTION_SIEM> to <internet> port 443 keep state label "M-06"

# M-07  MGMT default deny  [owner SEC, review Q]
block in quick log from <Z_MGMT> to any label "M-07"

# H-01  Backup out (brief)  [owner IT, review Q]
pass in quick log proto tcp from <G_HIS_SERVERS> to <H_BACKUP> port 8400 keep state label "H-01"

# H-02  E-prescribing and external lab results  [owner IT, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): app=ssl
pass in quick log proto tcp from <T_EMR_APP_IFENGINE> to <T_F_EPRESCRIBE_F_LABPARTNER> port 443 keep state label "H-02"

# H-03  Application notifications  [owner IT, review Q]
pass in quick log proto tcp from <G_HIS_SERVERS> to <H_MAILRELAY> port 25 keep state label "H-03"

# H-04  De-identified extracts pushed to research  [owner RES, review Q]
pass in quick log proto tcp from <H_DEID> to <H_SFTP_DROP> port 22 keep state label "H-04"

# H-05  Orders sent to radiology  [owner RAD, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): app=hl7
pass in quick log proto tcp from <H_IFENGINE> to <H_PACS_BROKER> port 2575 keep state label "H-05"

# H-06  Upstream time traceable to IST (CERT-In)  [owner IT, review Q]
pass in quick log proto udp from <H_NTP> to <F_NTP_UPSTREAM> port 123 keep state label "H-06"

# H-07  Recursive resolution  [owner IT, review Q]
pass in quick log proto tcp from <H_DNS> to <internet> port 53 keep state label "H-07"
pass in quick log proto udp from <H_DNS> to <internet> port 53 keep state label "H-07"

# H-08  HIS default deny  [owner IT, review Q]
block in quick log from <Z_HIS> to any label "H-08"

# D-01  Admin path never public  [owner IT, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): url_path=/admin/*
block in quick log proto tcp from <internet> to <H_PORTAL> port 443 label "D-01"

# D-02  Patient portal  [owner IT, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): url_path=/portal/*; ips=strict
pass in quick log proto tcp from <internet> to <H_PORTAL> port 443 keep state label "D-02"

# D-03  Portal back end  [owner IT, review Q]
pass in quick log proto tcp from <H_PORTAL> to <H_EMR_APP> port 443 keep state label "D-03"

# D-04  Outbound mail  [owner IT, review Q]
pass in quick log proto tcp from <H_MAILRELAY> to <internet> port 25 keep state label "D-04"

# D-05  Research inspected egress  [owner RES, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): profiles=file,dlp; tls_inspect=True
pass in quick log proto tcp from <H_PROXY> to <internet> port { 80 443 } keep state label "D-05"
pass in quick log proto udp from <H_PROXY> to <internet> port 443 keep state label "D-05"

# D-06  Vendor and DR tunnels  [owner SEC, review Q]
pass in quick log proto udp from <internet> to <EDGE_IPSEC> port { 500 4500 } keep state label "D-06"

# D-07  DMZ default deny  [owner IT, review Q]
block in quick log from <Z_DMZ> to any label "D-07"

# D-08  Inbound default deny  [owner SEC, review Q]
block in quick log from <internet> to any label "D-08"

# DV-01  Name resolution  [owner BIO, review M]
pass in quick log proto tcp from <Z_DEVICES> to <H_DNS> port 53 keep state label "DV-01"
pass in quick log proto udp from <Z_DEVICES> to <H_DNS> port 53 keep state label "DV-01"

# DV-02  Time  [owner BIO, review M]
pass in quick log proto udp from <Z_DEVICES> to <H_NTP> port 123 keep state label "DV-02"

# DV-03  Device data to EMR  [owner BIO, review M]
#   NGFW layer (Suricata/Zenarmor, not pf): app=hl7; ips=medical
pass in quick log proto tcp from <Z_DEVICES> to <H_IFENGINE> port 2575 keep state label "DV-03"

# DV-04  No peer traffic (with PVLAN)  [owner BIO, review M]
block in quick log from <Z_DEVICES> to <Z_DEVICES> label "DV-04"

# DV-05  Strict egress default  [owner BIO, review M]
block in quick log from <Z_DEVICES> to any label "DV-05"

# R-01  DNS, time, logon  [owner RAD, review Q]
pass in quick log proto tcp from <Z_RADIOLOGY> to <G_CORE> port { 53 88 636 } keep state label "R-01"
pass in quick log proto udp from <Z_RADIOLOGY> to <G_CORE> port { 53 88 123 } keep state label "R-01"

# R-02  Results and status to EMR  [owner RAD, review Q]
#   NGFW layer (Suricata/Zenarmor, not pf): app=hl7
pass in quick log proto tcp from <H_PACS_BROKER> to <H_IFENGINE> port 2575 keep state label "R-02"

